# ---- 공통 (MCP Server, Mail Worker) ----
# Railway Postgres 를 연결하면 자동 주입된다 (내부 네트워크 주소 사용 권장: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://user:password@postgres.railway.internal:5432/railway
# 외부 공개 URL(TLS)로 접속할 때만 require
# PGSSL=require

# 하이웍스 계정 (POP3/SMTP 사용 설정을 웹메일 환경설정에서 먼저 켜야 한다)
HIWORKS_USERNAME=your.email@yourcompany.com
HIWORKS_PASSWORD=your_password

# 사업명 분류 규칙 (JSON 배열). 제목/본문에 keywords 가 포함되면 name 으로 분류
PROJECT_RULES=[{"name":"A사업","keywords":["A사업","[A]"]},{"name":"B사업","keywords":["B사업"]}]

# ---- MCP Server ----
# 외부 연결 인증 토큰 (16자 이상, `openssl rand -hex 32`)
MCP_AUTH_TOKEN=change-me-to-a-long-random-token
PORT=3000
# AI 업무일지 (Anthropic). 없으면 mode=rules 만 동작
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# SSE 대신 JSON 응답을 쓰려면 true (일부 클라이언트 호환용)
# MCP_JSON_RESPONSE=false

# ---- Mail Worker ----
WORKER_MODE=loop            # loop | once (Railway cron 사용 시 once)
SYNC_INTERVAL_MINUTES=10
SYNC_BATCH_SIZE=200         # 1회 실행당 내려받을 최대 메일 수
SENT_SYNC_MODE=import       # import | webmail (webmail 은 미검증, Dockerfile.worker 필요)
EMAIL_RETENTION_DAYS=0      # 0 이면 무기한 보관. N 이면 N일 지난 메일 삭제

# ---- 웹메일 수집기 (SENT_SYNC_MODE=webmail, 미검증) ----
# WEBMAIL_LOGIN_URL=https://login.hiworks.com/
# WEBMAIL_USERNAME_SELECTOR=
# WEBMAIL_PASSWORD_SELECTOR=
# WEBMAIL_SUBMIT_SELECTOR=
# WEBMAIL_LOGGED_IN_SELECTOR=
# WEBMAIL_SENT_FOLDER_URL=
# WEBMAIL_MAIL_LINK_SELECTOR=
# WEBMAIL_ORIGINAL_LINK_SELECTOR=
# WEBMAIL_NEXT_PAGE_SELECTOR=
# WEBMAIL_MAX_PAGES=3

# ---- 로컬 stdio MCP (선택) ----
# HIWORKS_STATE_DIR=~/.hiworks-mcp
# HIWORKS_DOWNLOAD_DIR=~/Downloads/hiworks-mcp
